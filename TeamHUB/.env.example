# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GROQ_API_KEY: Fallback AI provider for AI Assistant
VITE_GROQ_API_KEY="MY_GROQ_API_KEY"
GROQ_API_KEY="MY_GROQ_API_KEY"

# Configurable AI Model Names (Defaults used if omitted)
# GEMINI_PRIMARY_MODEL defaults to "gemini-3.8-flash"
# GEMINI_FALLBACK_MODEL defaults to "gemini-3.7-flash"
# GROQ_MODEL defaults to "openai/gpt-oss-120b"
VITE_GEMINI_PRIMARY_MODEL="gemini-3.8-flash"
GEMINI_PRIMARY_MODEL="gemini-3.8-flash"
VITE_GEMINI_FALLBACK_MODEL="gemini-3.7-flash"
GEMINI_FALLBACK_MODEL="gemini-3.7-flash"
VITE_GROQ_MODEL="openai/gpt-oss-120b"
GROQ_MODEL="openai/gpt-oss-120b"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase configuration for avatars storage and profile management
VITE_SUPABASE_URL="https://xyzcompany.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."
